<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transaction History - miniLibrary</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>📚 Transaction History</h1>
      <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <table class="transactions-table">
      <thead>
        <tr>
          <th>Date & Time</th>
          <th>Book Title</th>
          <th>Author</th>
          <th>User</th>
          <th>Action</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(transaction => { %>
          <tr>
            <td><%= new Date(transaction.date).toLocaleString() %></td>
            <td><%= transaction.book ? transaction.book.title : 'Deleted Book' %></td>
            <td><%= transaction.book ? transaction.book.author : 'N/A' %></td>
            <td><%= transaction.user ? transaction.user.username : 'Unknown' %></td>
            <td>
              <span class="badge <%= transaction.type === 'check-out' ? 'badge-checkout' : 'badge-checkin' %>">
                <%= transaction.type %>
              </span>
            </td>
            <td><%= transaction.notes || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (transactions.length === 0) { %>
      <p style="text-align: center; padding: 40px; color: #718096;">
        No transactions yet. Start borrowing books!
      </p>
    <% } %>
  </div>
</body>
</html>
